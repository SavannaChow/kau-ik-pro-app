# Find these values over SSH with: id
PUID=1026
PGID=100

# Browser URL will be http://10.98.42.118:8080
KAUIK_PORT=8080
KAUIK_WEB_USERNAME=admin
KAUIK_WEB_PASSWORD=replace-with-a-long-unique-password

# Generate once with: openssl rand -hex 32
# Never change it after entering broker credentials in the web UI, or the
# saved encrypted credentials can no longer be decrypted.
KAUIK_SECRET_KEY=replace-with-64-random-hex-characters

# Mock mode is the safe default. Broker settings can be entered later in UI.
MARKET_PROVIDER=mock
TRADE_PROVIDER=mock
FUGLE_API_KEY=

# Optional: persistent broker credentials may instead be supplied here.
# Certificate files live in ./certificates and use container paths such as:
# FUBON_CERT_PATH=/app/certificates/fubon.pfx

# Mega is configured most easily in the web UI. Its PFX path is a Windows VM
# path (for example C:\MegaAPI\certificate.pfx), not /app/certificates.
# MEGA_BRIDGE_URL=http://WINDOWS_VM_IP:8787
# MEGA_BRIDGE_TOKEN=the-same-long-token-as-the-Windows-bridge
