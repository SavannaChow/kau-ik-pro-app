# Use a long random value; set the same value in Kau-ik Pro's Mega setup.
MEGA_BRIDGE_TOKEN=replace-with-a-long-random-token

# Values supplied by Mega Securities in speedyAPI_config.json/support.
MEGA_ORDER_HOST=replace-with-mega-order-host
MEGA_ORDER_PORT=0

# Keep 0.0.0.0 only on the private Synology/VM LAN. Restrict Windows Firewall
# to the Synology IP (10.98.42.118).
MEGA_BRIDGE_HOST=0.0.0.0
MEGA_BRIDGE_PORT=8787

# Safe local verification without loading Mega's DLL or sending orders.
MEGA_BRIDGE_MOCK=0
